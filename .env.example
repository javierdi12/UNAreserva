
# MongoDB
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/unareserva_db?retryWrites=true&w=majority
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=UNAreserva:
# SQLite
SQLITE_PATH=./data/unareserva_local.db
# Flask
FLASK_SECRET_KEY=cambia_esta_clave_en_produccion
FLASK_ENV=development
# SMTP para recuperación de contraseña
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=usuario@example.com
SMTP_PASSWORD=tu-clave-smtp
SMTP_FROM=usuario@example.com
SMTP_USE_TLS=true
APP_BASE_URL=http://localhost:5000
# Administrador inicial (solo para scripts/init_admin.py)
ADMIN_NAME=Administrador UNAreserva
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=define-una-clave-segura
