
# MongoDB
MONGO_URI=mongodb+srv://usuario:password@cluster0.xxxxx.mongodb.net/unareserva_db?retryWrites=true&w=majority
# Redis
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PREFIX=UNAreserva:
# SQLite
SQLITE_PATH=./data/unareserva_local.db
# Flask
FLASK_SECRET_KEY=cambia_esta_clave_en_produccion
FLASK_ENV=development
# MailerLite para recuperación de contraseña
MAILERLITE_API_TOKEN=tu-token-de-mailerlite
MAILERLITE_API_BASE_URL=https://connect.mailerlite.com/api
MAILERLITE_RESET_GROUP_ID=id-del-grupo-de-recuperacion
MAILERLITE_RESET_FIELD_KEY=reset_link
MAILERLITE_API_VERSION=
MAILERLITE_TIMEOUT=10
APP_BASE_URL=http://localhost:5000
# Administrador inicial (solo para scripts/init_admin.py)
ADMIN_NAME=Administrador UNAreserva
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=define-una-clave-segura
